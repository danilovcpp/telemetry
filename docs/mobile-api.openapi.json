{
  "openapi": "3.1.1",
  "info": {
    "title": "DeviceTelemetry Mobile API",
    "version": "1.3.0",
    "description": "Read API for the DeviceTelemetry mobile app. Human-readable guide: docs/mobile-api.md.\n\n**Temporarily public (MVP):** no authentication. `customerId` and `deviceId` in the URL do not prove access rights. Authentication and owner checks will be added before a public production launch, which will change this contract.\n\nErrors are RFC 9457 problem details (`application/problem+json`) with a stable `code`; request validation errors (400) carry `errors` instead. Rate limit: 120 requests per minute per client IP, exceeded requests get 429 with `Retry-After`.\n\n**Live values** are a WebSocket, `GET /api/mobile/devices/{deviceId}/live`, which OpenAPI cannot describe: see docs/mobile-api.md (frames `status` and `values`). Offer it only when the device card's `features` contains `live`; `logs` and `data` need `history`. Live values and data files come from the devices over Device Link (`/api/device/v1/link`, not part of this API)."
  },
  "servers": [
    {
      "url": "{baseUrl}",
      "description": "Service base URL, e.g. the Staging VPS.",
      "variables": {
        "baseUrl": {
          "default": "http://localhost:8080"
        }
      }
    }
  ],
  "paths": {
    "/api/mobile/customers/{customerId}/devices": {
      "get": {
        "tags": [
          "Mobile (temporarily public)"
        ],
        "summary": "Devices of a customer.",
        "description": "All devices of the customer sorted by name, then id. Not paginated: devices are provisioned manually and their\r\nnumber per customer is small. An existing customer without devices yields an empty array.\r\n\r\n    GET /api/mobile/customers/42/devices",
        "parameters": [
          {
            "name": "customerId",
            "in": "path",
            "description": "Internal customer id.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The customer's devices (possibly empty).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceListItemDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The customer does not exist (`customer.not_found`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/mobile/devices/{deviceId}": {
      "get": {
        "tags": [
          "Mobile (temporarily public)"
        ],
        "summary": "Device card.",
        "description": "`lastEventAtUtc` / `lastStatusCode` come from the most recent event by device time (`occurredAtUtc`):\r\nthe last known status, not a guaranteed current state. Both are `null` when the device has no events.\r\n\r\n    GET /api/mobile/devices/15",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "description": "Internal device id (`id` from the device list), not the device code.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The device.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceDetailsDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The device does not exist (`device.not_found`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/mobile/devices/{deviceId}/state": {
      "get": {
        "tags": [
          "Mobile (temporarily public)"
        ],
        "summary": "Current state of a device.",
        "description": "The last regular report (status 100010, by device time) plus the server's liveness view. Values and the state of\r\neach channel are in `lastReport.payload.values`; show only the channels present there (a channel removed on the\r\ndevice disappears from its reports). `silentSinceUtc` is set while the device is considered silent; this is\r\nchecked only for devices that announce `reportIntervalS`.\r\n\r\n    GET /api/mobile/devices/15/state",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "description": "Internal device id, not the device code.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The device state; `lastReport` is `null` if the device never sent a report.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceStateDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The device does not exist (`device.not_found`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/mobile/devices/{deviceId}/events": {
      "get": {
        "tags": [
          "Mobile (temporarily public)"
        ],
        "summary": "Event history of a device, newest first.",
        "description": "Cursor pagination, ordered by `occurredAtUtc` descending, then `id` descending. Request the first page\r\nwithout `cursor`; while `hasMore` is true, pass the returned `nextCursor` unchanged to get the next\r\npage. Events with equal timestamps are never skipped or repeated. `payload` is the JSON object the device sent.\r\n\r\n    GET /api/mobile/devices/15/events?limit=20\r\n    GET /api/mobile/devices/15/events?limit=20&amp;cursor=AAjc...",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "description": "Internal device id, not the device code.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, 1–100; default 20.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque `nextCursor` from the previous page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of events (possibly empty).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfDeviceEventDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid `limit` or `cursor` (`pagination.invalid_limit`, `pagination.invalid_cursor`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The device does not exist (`device.not_found`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/mobile/devices/{deviceId}/logs": {
      "get": {
        "tags": [
          "Mobile (temporarily public)"
        ],
        "summary": "Stored data: months or daily files of one channel.",
        "description": "Data files copied from the device (feature `history`). Without `month`: the months that have files, ascending.\r\nWith `month`: the daily files of that month, ascending by path. `size` is what the server holds now;\r\n`complete` means the day is closed and fully copied, so the file will not change any more. Channel 0 is the\r\nsummary file of all channels. Served from the server copies, whether or not the device is online.\r\n\r\n    GET /api/mobile/devices/15/logs?ch=1\r\n    GET /api/mobile/devices/15/logs?ch=1&amp;month=2026-10",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "description": "Internal device id, not the device code.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "ch",
            "in": "query",
            "description": "Channel number; 0 = summary file.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "month",
            "in": "query",
            "description": "Month `YYYY-MM`; omit to list months.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`{\"months\":[…]}` without `month`, `{\"days\":[…]}` with it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceLogsResponse"
                }
              }
            }
          },
          "400": {
            "description": "`ch` missing or not a number (`logs.invalid_channel`), malformed `month` (`logs.invalid_month`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The device does not exist (`device.not_found`), has no `history` (`feature.not_available`), or no files in that month (`log.not_found`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/mobile/devices/{deviceId}/data/{path}": {
      "get": {
        "tags": [
          "Mobile (temporarily public)"
        ],
        "summary": "Stored data: the bytes of one daily file.",
        "description": "The server copy as it is (tab-separated, as written by the device; no charset is declared). Pass `path` from\r\nthe day list URL-encoded as one segment. Supports `HEAD`, `Range` (206; 416 outside the copy),\r\n`If-None-Match` and `If-Range`; the `ETag` changes whenever the copy grows or is re-read. While a\r\nday is not `complete` the file can grow: request the tail with `Range: bytes=&lt;size&gt;-`.\r\n\r\n    GET /api/mobile/devices/15/data/LOG%2FCH1%2F2026-10%2F23.TSV",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "description": "Internal device id, not the device code.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "path",
            "in": "path",
            "description": "File path from the day list, URL-encoded.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The whole copy.",
            "content": {
              "text/tab-separated-values": {
                "schema": {
                  "$ref": "#/components/schemas/Stream"
                }
              }
            }
          },
          "206": {
            "description": "The requested range.",
            "content": {
              "text/tab-separated-values": {
                "schema": {
                  "$ref": "#/components/schemas/Stream"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The device does not exist (`device.not_found`), has no `history` (`feature.not_available`), or no such file (`log.not_found`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "416": {
            "description": "The range is outside the copy.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Not copied yet: being copied now, retry after `Retry-After` seconds (`sync.pending`), or the device is offline (`device.offline`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "head": {
        "tags": [
          "Mobile (temporarily public)"
        ],
        "summary": "Stored data: the bytes of one daily file.",
        "description": "The server copy as it is (tab-separated, as written by the device; no charset is declared). Pass `path` from\r\nthe day list URL-encoded as one segment. Supports `HEAD`, `Range` (206; 416 outside the copy),\r\n`If-None-Match` and `If-Range`; the `ETag` changes whenever the copy grows or is re-read. While a\r\nday is not `complete` the file can grow: request the tail with `Range: bytes=&lt;size&gt;-`.\r\n\r\n    GET /api/mobile/devices/15/data/LOG%2FCH1%2F2026-10%2F23.TSV",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "description": "Internal device id, not the device code.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "path",
            "in": "path",
            "description": "File path from the day list, URL-encoded.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The whole copy.",
            "content": {
              "text/tab-separated-values": {
                "schema": {
                  "$ref": "#/components/schemas/Stream"
                }
              }
            }
          },
          "206": {
            "description": "The requested range.",
            "content": {
              "text/tab-separated-values": {
                "schema": {
                  "$ref": "#/components/schemas/Stream"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "The device does not exist (`device.not_found`), has no `history` (`feature.not_available`), or no such file (`log.not_found`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "416": {
            "description": "The range is outside the copy.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Not copied yet: being copied now, retry after `Retry-After` seconds (`sync.pending`), or the device is offline (`device.offline`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeviceDetailsDto": {
        "required": [
          "id",
          "deviceCode",
          "name",
          "customerId",
          "lastEventAtUtc",
          "lastStatusCode",
          "lastSeenAtUtc",
          "reportIntervalS",
          "silentSinceUtc",
          "offlineAfterS",
          "monitoring",
          "timeZone",
          "channels",
          "features"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "deviceCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "customerId": {
            "type": "integer",
            "format": "int32"
          },
          "lastEventAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastStatusCode": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "lastSeenAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "reportIntervalS": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "silentSinceUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "offlineAfterS": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "monitoring": {
            "type": "boolean"
          },
          "timeZone": {
            "type": [
              "null",
              "string"
            ]
          },
          "channels": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/TelemetryChannel"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DeviceEventDto": {
        "required": [
          "id",
          "statusCode",
          "occurredAtUtc",
          "receivedAtUtc",
          "payload",
          "source",
          "channels",
          "occurredAtRejected"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "statusCode": {
            "type": "integer",
            "format": "int32"
          },
          "occurredAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "receivedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "payload": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {},
            "description": "Device-specific JSON object exactly as the device sent it; no fixed schema. Null when absent."
          },
          "source": {
            "type": "string"
          },
          "channels": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/TelemetryChannel"
            }
          },
          "occurredAtRejected": {
            "type": "boolean"
          }
        }
      },
      "DeviceListItemDto": {
        "required": [
          "id",
          "deviceCode",
          "name",
          "lastSeenAtUtc",
          "silentSinceUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "deviceCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "lastSeenAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "silentSinceUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "DeviceLogDayDto": {
        "required": [
          "path",
          "size",
          "complete"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "complete": {
            "type": "boolean"
          }
        }
      },
      "DeviceLogsResponse": {
        "type": "object",
        "properties": {
          "months": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "Months with files, `YYYY-MM`, ascending."
          },
          "days": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/DeviceLogDayDto"
            },
            "description": "Daily files of the month, ascending by path."
          }
        },
        "description": "Exactly one of `months` (no `month` requested) and `days` is present."
      },
      "DeviceReportDto": {
        "required": [
          "eventId",
          "occurredAtUtc",
          "receivedAtUtc",
          "payload"
        ],
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAtUtc": {

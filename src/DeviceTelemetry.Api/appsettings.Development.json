{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "TelemetryDatabase": "Host=localhost;Port=5432;Database=device_telemetry;Username=postgres"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "FromEmail": "telemetry@localhost.test"
  },
  "DeviceLink": {
    "Enabled": true
  },
  "MobileApi": {
    "LiveEnabled": true,
    "HistoryEnabled": true
  }
}

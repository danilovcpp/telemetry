<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <UserSecretsId>devicetelemetry-api</UserSecretsId>
        <!-- XML comments feed the OpenAPI document; not every public member or injected parameter needs one. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

    <!-- Container image built by `dotnet publish -t:PublishContainer` (no Docker daemon needed). Same base image as the Dockerfile. -->
    <PropertyGroup>
        <Version>1.6.0</Version>
        <ContainerRepository>fkonstantin/telemetry</ContainerRepository>
        <ContainerImageTags>$(Version);latest</ContainerImageTags>
        <!-- amd64 and arm64 VPS hosts; restore needs both runtime identifiers. -->
        <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
        <ContainerRuntimeIdentifiers>linux-x64;linux-arm64</ContainerRuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <ContainerLabel Include="org.opencontainers.image.title" Value="DeviceTelemetry API" />
        <ContainerLabel Include="org.opencontainers.image.description" Value="Device telemetry ingestion with email notifications" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
        <PackageReference Include="Swashbuckle.AspNetCore"/>
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DeviceTelemetry.Application\DeviceTelemetry.Application.csproj" />
      <ProjectReference Include="..\DeviceTelemetry.Infrastructure\DeviceTelemetry.Infrastructure.csproj" />
    </ItemGroup>

</Project>

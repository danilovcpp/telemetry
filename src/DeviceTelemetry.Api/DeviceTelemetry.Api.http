@DeviceTelemetry.Api_HostAddress = http://localhost:5146
# Issue a key with: dotnet run --project src/DeviceTelemetry.Api -- issue-device-key <deviceCode>
@deviceKey = dtk_replace_me

### Minimal contract
POST {{DeviceTelemetry.Api_HostAddress}}/api/telemetry/send
Content-Type: application/json
X-Device-Key: {{deviceKey}}

{
  "deviceId": "uid",
  "statusCode": 100001
}

### Extended contract (idempotent through messageId)
POST {{DeviceTelemetry.Api_HostAddress}}/api/telemetry/send
Content-Type: application/json
X-Device-Key: {{deviceKey}}

{
  "deviceId": "uid",
  "statusCode": 100001,
  "messageId": "b5e15f27-3fb8-4e25-8c2f-f1a1b203b821",
  "occurredAtUtc": "2026-10-16T10:30:00Z",
  "payload": {
    "temperature": 25.4,
    "voltage": 3.3
  }
}

### 1.3: channels, device notification address and report interval
POST {{DeviceTelemetry.Api_HostAddress}}/api/telemetry/send
Content-Type: application/json
X-Device-Key: {{deviceKey}}

{
  "deviceId": "uid",
  "statusCode": 100003,
  "messageId": "6f1c2a4e-0b7d-4c55-9a1e-3d2f8b9c0a11",
  "channels": [ { "id": "ch2", "name": "130AA15P20" }, { "id": "ch5", "name": "130AA15P21" } ],
  "notifyEmail": "site-7@example.org",
  "reportIntervalS": 300
}

### Device state (mobile API)
GET {{DeviceTelemetry.Api_HostAddress}}/api/mobile/devices/1/state

### 1.4: notification language chosen by the device (en, ru, de)
POST {{DeviceTelemetry.Api_HostAddress}}/api/telemetry/send
Content-Type: application/json
X-Device-Key: {{deviceKey}}

{
  "deviceId": "uid",
  "statusCode": 100001,
  "notifyLanguage": "de"
}

### 1.5: device settings (absent fields are kept; invalid values are listed in "rejected")
POST {{DeviceTelemetry.Api_HostAddress}}/api/telemetry/settings
Content-Type: application/json
X-Device-Key: {{deviceKey}}

{
  "deviceId": "uid",
  "name": "DataLoggerSTM32",
  "notifyEmail": "site-7@example.org",
  "notifyLanguage": "ru",
  "timeZone": "Europe/Berlin",
  "reportIntervalS": 300,
  "offlineAfterS": 1800,
  "monitoring": true,
  "channels": [ { "id": "ch1", "name": "130AA15P20" }, { "id": "ch2", "name": "TEX0000001" } ]
}

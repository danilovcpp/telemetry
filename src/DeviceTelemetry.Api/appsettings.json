{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 32768
    }
  },
  "Telemetry": {
    "MaxPayloadBytes": 8192,
    "MaxClockSkew": "00:05:00"
  },
  "RateLimiting": {
    "Telemetry": {
      "PermitLimit": 600,
      "Window": "00:01:00"
    }
  },
  "Outbox": {
    "BatchSize": 20,
    "PollingInterval": "00:00:05",
    "MaxAttempts": 8,
    "BaseRetryDelay": "00:00:30",
    "MaxRetryDelay": "01:00:00",
    "LockDuration": "00:05:00"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "Username": "",
    "FromEmail": "",
    "FromName": "Device Telemetry",
    "Timeout": "00:00:30"
  }
}

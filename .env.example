# DeviceTelemetry API runtime configuration.
# Copy to .env and fill in the secrets; .env is git-ignored. Used by docker-compose.yml and by
# `docker run --env-file .env`. Values are taken literally: do not wrap them in quotes.

# --- Image (docker-compose only) ---
API_IMAGE=devicetelemetry-api:1.0.0

# --- Hosting ---
# Staging applies migrations on startup and seeds 10 customers / 50 devices into an empty database,
# logging the device API keys. Use Production for real deployments.
ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_HTTP_PORTS=8080
API_PORT=8080

# --- PostgreSQL ---
# POSTGRES_* initialise the bundled postgres container; the connection string must use the same values.
POSTGRES_DB=device_telemetry
POSTGRES_USER=device_telemetry
POSTGRES_PASSWORD=change-me
ConnectionStrings__TelemetryDatabase=Host=postgres;Port=5432;Database=device_telemetry;Username=device_telemetry;Password=change-me
Database__ApplyMigrationsOnStartup=true

# --- SMTP ---
# Defaults point at the bundled Mailpit test server (web UI on MAILPIT_UI_PORT). For a real provider use
# Port=587 + Security=StartTls (or 465 + SslOnConnect) and set Username/Password.
Smtp__Host=mailpit
Smtp__Port=1025
Smtp__Security=None
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=telemetry@staging.example.com
Smtp__FromName=Device Telemetry (Staging)
Smtp__Timeout=00:00:30
MAILPIT_UI_PORT=8025

# --- Outbox worker ---
Outbox__BatchSize=20
Outbox__PollingInterval=00:00:05
Outbox__MaxAttempts=8
Outbox__BaseRetryDelay=00:00:30
Outbox__MaxRetryDelay=01:00:00
Outbox__LockDuration=00:05:00

# --- Request limits ---
Telemetry__MaxPayloadBytes=8192
Telemetry__MaxClockSkew=00:05:00
Kestrel__Limits__MaxRequestBodySize=32768
RateLimiting__Telemetry__PermitLimit=600
RateLimiting__Telemetry__Window=00:01:00

# --- Logging ---
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
